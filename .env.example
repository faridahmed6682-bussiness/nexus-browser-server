# Nexus Browser Worker — copy to .env for local runs. NEVER commit .env.
# On Railway/Render, set these as service environment variables instead.

PORT=3000

# Shared secret the Nexus app sends as the `x-api-key` header.
# Generate one with:  openssl rand -hex 32
# The same value must be stored in the Nexus app (Settings > Browser worker).
BROWSER_WORKER_KEY=

# Max time for one browse/read task, in ms.
TASK_TIMEOUT_MS=60000

# Max tasks waiting in the queue (one runs at a time; free-tier RAM).
MAX_QUEUE=5

# --- GitHub App (optional; enables GitHub App installation connect) ---
# Register at https://github.com/settings/apps/new — see README "GitHub App
# connect" for the webhook URL and permissions.
# Webhook URL: <your Railway/Render URL>/github/webhook
GITHUB_APP_ID=
# Private key (PEM) from the GitHub App settings page. Paste it with real
# newlines, or as one line with literal \n — the server converts \n for you.
GITHUB_APP_PRIVATE_KEY=
# Webhook secret (the same value you set on the GitHub App settings page).
GITHUB_WEBHOOK_SECRET=

# --- Push notifications (FCM via Firebase Admin SDK, lib/push.js) --------
# Service-account key JSON for Firebase project nexus-ai-9df20, as ONE
# string (the whole JSON file contents). Generate it in the Firebase
# console: Project settings -> Service accounts -> Generate new private key.
# NEVER commit the key or paste it into chat. If unset, push is disabled
# (server keeps running; POST /api/notify returns 503).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# --- AI Studio build agent LLM (dedicated keys, server-side) --------------
# The build agent (POST /api/agent/build, lib/aistudio-agent.js) drives AI
# Studio builds end-to-end. Provider: Google AI Studio (Gemini).
# Primary model: gemini-3.6-flash (full flash, vision-capable, in the
# verified free chain — distinct from the chat default gemini-3.1-flash-lite).
# Failover chain, inside the agent's OWN slots only, in fixed order:
#   gemini-3.6-flash [BROWSER_AGENT_GEMINI_KEY]
#   -> gemini-3.1-flash-lite [same dedicated key]
#   -> OpenRouter qwen/qwen3-coder:free [BROWSER_AGENT_OPENROUTER_KEY]
#   -> stop with a clear error.
# Quota isolation: these are the agent's OWN dedicated key slots, separate
# from every chat key — never shared with the chat agents, never Groq. One
# agent's quota running out never stops the others. The user supplies the
# keys via Railway/Render Variables; never commit .env, never print a key.
# If BROWSER_AGENT_GEMINI_KEY is empty, the agent is unconfigured:
# /api/agent/build still accepts the job (202) and the job finishes fast
# with status 'not-configured' so the app sees a clear job record.
BROWSER_AGENT_GEMINI_KEY=
# --- Web search: Brave Search (primary) + Google CSE (secondary) + DuckDuckGo (fallback) ---
# Brave Search API — free plan (monthly allowance), 1 request/second. Card required at signup (see MANIFEST).
# Get a key at https://api-dashboard.search.brave.com (free plan).
# NOTE: Brave's FAQ (brave.com/search/api/) says a credit card IS
# required at signup even for the free plan (anti-fraud, not charged).
# If no key can be obtained, leave this empty — search falls back to
# Google CSE (when configured) then DuckDuckGo HTML (free, no key).
# The response says which provider answered. DuckDuckGo stays the
# browser homepage/default; this only changes how a search is answered.
BRAVE_SEARCH_API_KEY=
# Google Programmable Search Engine (SECONDARY leg — effectively dormant):
# free plan 100 queries/day, then $5 per 1,000 queries. Create the two
# values in Google Cloud (see README "Search: Brave Search + Google CSE
# + DuckDuckGo fallback"): a Programmable Search Engine ID (cx) and an
# API key with the Custom Search API enabled.
# LIMITATION: whole-web search is deprecated for NEW engines — the engine
# created for Nexus searches ONLY example.com (forced placeholder; the
# switch is greyed out). Unless domains are added to that engine, this
# leg answers example.com-only results, so the env vars are left unset
# on the hosts and the leg is skipped. When either is empty, or the
# 100/day quota is used up, or Google returns an error, search falls
# back to DuckDuckGo HTML.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
# --- Web search: free no-card legs (Tavily / Exa / Firecrawl / SearXNG) ---
# These legs run BEFORE Brave/Google/DDG (see README "/api/search").
# Each key-gated leg is SKIPPED when its key is empty — never commit a
# real key here; set the values as Railway/Render Variables instead.
# Tavily — free tier, email signup, no card. Get a key at
# https://tavily.com (dashboard -> API keys). Free-tier search API.
TAVILY_API_KEY=
# Exa — free tier, email signup, no card. Get a key at
# https://exa.ai (dashboard -> API keys). Free-tier search API.
EXA_API_KEY=
# Firecrawl — free tier, email signup, no card. Get a key at
# https://firecrawl.dev (dashboard -> API keys). Free-tier search API.
FIRECRAWL_API_KEY=
# SearXNG — self-hosted metasearch instance (no key). Set this to the
# base URL of a SearXNG instance, e.g. https://searxng.example.com
# (no trailing slash needed; the server appends /search). Leave empty
# and the SearXNG leg is skipped. A public instance works too, but
# self-hosted on Render free is the plan (see README "/api/search").
SEARXNG_URL=
# Test override only (smoke tests): base URL of the DuckDuckGo HTML
# endpoint. Leave unset in production.
# DDG_HTML_BASE_URL=https://html.duckduckgo.com/html/

# Optional — enables the last failover leg (OpenRouter qwen/qwen3-coder:free).
# Its own dedicated key slot; never a chat agent's key.
BROWSER_AGENT_OPENROUTER_KEY=
# Optional — per-model RPM budget for the agent's failover rotation
# (default 30/min per model; rotate BEFORE hitting the limit).
BROWSER_AGENT_RPM_BUDGET=30
