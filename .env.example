# Nexus Browser Worker — copy to .env for local runs. NEVER commit .env.
# On Railway/Render, set these as service environment variables instead.

PORT=3000

# Shared secret the Nexus app sends as the `x-api-key` header.
# Generate one with:  openssl rand -hex 32
# The same value must be stored in the Nexus app (Settings > Browser worker).
BROWSER_WORKER_KEY=

# Max time for one browse/read task, in ms.
TASK_TIMEOUT_MS=60000

# Max tasks waiting in the queue (one runs at a time; free-tier RAM).
MAX_QUEUE=5

# --- GitHub App (optional; enables GitHub App installation connect) ---
# Register at https://github.com/settings/apps/new — see README "GitHub App
# connect" for the webhook URL and permissions.
# Webhook URL: <your Railway/Render URL>/github/webhook
GITHUB_APP_ID=
# Private key (PEM) from the GitHub App settings page. Paste it with real
# newlines, or as one line with literal \n — the server converts \n for you.
GITHUB_APP_PRIVATE_KEY=
# Webhook secret (the same value you set on the GitHub App settings page).
GITHUB_WEBHOOK_SECRET=

# --- Push notifications (FCM via Firebase Admin SDK, lib/push.js) --------
# Service-account key JSON for Firebase project nexus-ai-9df20, as ONE
# string (the whole JSON file contents). Generate it in the Firebase
# console: Project settings -> Service accounts -> Generate new private key.
# NEVER commit the key or paste it into chat. If unset, push is disabled
# (server keeps running; POST /api/notify returns 503).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
